# ==============================================================================
# ElevAlte Environment Configuration Template
# Learn Smarter • Grow Faster • Achieve More
# ==============================================================================

# ------------------------------------------------------------------------------
# DEVELOPMENT MODE (Default)
# ElevAlte runs zero-dependency in-memory repository seeded with Alex Johnson data.
# No PostgreSQL/Supabase installation required for local hackathon demo.
# ------------------------------------------------------------------------------
ENVIRONMENT=development
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8000
SECRET_KEY=elevalte_super_secret_jwt_key_hackathon_demo
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000","http://localhost:3001"]

# Frontend environment variables (put in frontend/.env.local)
NEXT_PUBLIC_API_URL=http://127.0.0.1:8000/api/v1
NEXT_PUBLIC_USE_MOCK_API=false

# ------------------------------------------------------------------------------
# SUPABASE POSTGRESQL DATABASE CONFIGURATION
# ------------------------------------------------------------------------------
# Runtime application connection (Supabase Transaction Pooler, port 6543):
DATABASE_URL="postgresql://postgres.odjxspxozykmmoavwlic:[PASSWORD]@aws-0-ap-northeast-2.pooler.supabase.com:6543/postgres?pgbouncer=true"

# Direct / Session migration connection (Supabase Session Pooler / Direct, port 5432):
DIRECT_URL="postgresql://postgres.odjxspxozykmmoavwlic:[PASSWORD]@aws-0-ap-northeast-2.pooler.supabase.com:5432/postgres"

# Optional Supabase API keys
SUPABASE_URL=https://odjxspxozykmmoavwlic.supabase.co
SUPABASE_KEY=your_supabase_anon_key

# External LLM Integration (Optional - falls back to local AI engine if unset)
# OPENAI_API_KEY=sk-...
# GEMINI_API_KEY=AIza...

